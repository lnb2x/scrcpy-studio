{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Scrcpy Studio",
  "version": "0.1.0",
  "identifier": "io.github.lnb2x.scrcpystudio",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Scrcpy Studio",
        "width": 1280,
        "height": 820,
        "minWidth": 1080,
        "minHeight": 680,
        "resizable": true,
        "fullscreen": false,
        "decorations": false,
        "center": true,
        "transparent": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' asset: http://asset.localhost data:; style-src 'self' 'unsafe-inline'; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "publisher": "lnb2x",
    "shortDescription": "Android Device Control Studio powered by scrcpy and ADB",
    "longDescription": "A Windows desktop application for discovering, configuring, mirroring, recording, and controlling Android devices with scrcpy and ADB.",
    "copyright": "Copyright © 2026 lnb2x",
    "category": "DeveloperTool",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": true
      }
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/lnb2x/scrcpy-studio/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
